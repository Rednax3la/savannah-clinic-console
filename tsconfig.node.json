{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": ["vite.config.*", "vitest.config.*", "eslint.config.*"],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // vitest.config.ts imports ./vite.config.ts with its extension, which is
    // what Vite's native config loader wants. Safe here: this project never
    // emits, it only type-checks.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  }
}
